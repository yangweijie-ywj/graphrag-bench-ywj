      <data key="d1">disease</data>
      <data key="d2">Non-Alcoholic Fatty Liver Disease (NAFLD) is a condition where fat builds up in the liver, potentially leading to cirrhosis.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
