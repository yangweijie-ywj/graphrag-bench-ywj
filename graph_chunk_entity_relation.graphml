    </node>
    <node id="Radon">
      <data key="d0">Radon</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Radon is a radioactive gas that can increase the risk of lung cancer when inhaled.&lt;SEP&gt;Radon is a naturally occurring radioactive gas that can increase the risk of lung cancer.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-7843955573cdc294b34e74019195fafb</data>
      <data key="d4">unknown_source</data>
