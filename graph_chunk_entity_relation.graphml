      <data key="d0">NCCN Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">The NCCN Foundation is an organization that supports cancer patients and funds the development of NCCN Guidelines for Patients.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
      <data key="d4">unknown_source</data>
