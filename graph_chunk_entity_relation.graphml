    <node id="NCCN Clinical Practice Guidelines in Oncology">
      <data key="d0">NCCN Clinical Practice Guidelines in Oncology</data>
      <data key="d1">content</data>
      <data key="d2">The NCCN Clinical Practice Guidelines in Oncology are evidence-based recommendations for cancer care used by healthcare providers worldwide.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839757</data>
