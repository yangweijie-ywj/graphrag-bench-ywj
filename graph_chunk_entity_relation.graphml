    <node id="Brain CT Scan">
      <data key="d0">Brain CT Scan</data>
      <data key="d1">event</data>
      <data key="d2">A brain CT scan uses x-rays and computer technology to create detailed images of the brain, often to detect bleeding.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f</data>
      <data key="d4">unknown_source</data>
