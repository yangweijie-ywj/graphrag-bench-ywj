    <node id="Muscularis Mucosa">
      <data key="d0">Muscularis Mucosa</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Muscularis mucosa is a thin layer of muscle beneath the lamina propria.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
