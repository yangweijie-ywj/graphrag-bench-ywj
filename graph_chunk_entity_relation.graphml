      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Peripheral Neuropathy">
      <data key="d0">Peripheral Neuropathy</data>
      <data key="d1">concept</data>
      <data key="d2">Peripheral neuropathy is a side effect of paclitaxel, causing pain, tingling, and numbness in the hands and feet.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Malignant Pleural Effusion">
      <data key="d0">Malignant Pleural Effusion</data>
      <data key="d1">concept</data>
      <data key="d2">Malignant pleural effusion is a condition where cancer cells are found in the fluid around the lungs, associated with stage 4A of ovarian cancer.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
