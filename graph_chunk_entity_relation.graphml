      <data key="d0">Oxaliplatin Neuropathy</data>
      <data key="d1">condition</data>
      <data key="d2">Oxaliplatin neuropathy refers to nerve damage caused by the chemotherapy drug oxaliplatin.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Irinotecan Side Effects">
      <data key="d0">Irinotecan Side Effects</data>
      <data key="d1">condition</data>
      <data key="d2">Irinotecan side effects include gastrointestinal issues and hair loss due to the chemotherapy drug irinotecan.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Scientist">
      <data key="d0">Scientist</data>
      <data key="d1">person</data>
      <data key="d2">Scientists are individuals who have studied and learned about prostate cancer, contributing to better detection methods and treatments.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Detection Methods">
      <data key="d0">Detection Methods</data>
      <data key="d1">method</data>
      <data key="d2">Detection methods refer to the techniques used to identify prostate cancer, including PSA tests and digital rectal exams.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Best Practices">
      <data key="d0">Best Practices</data>
      <data key="d1">concept</data>
      <data key="d2">Best practices are established guidelines derived from research and expert opinions to ensure effective treatment of advanced-stage prostate cancer.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="PSA Test">
      <data key="d0">PSA Test</data>
      <data key="d1">method</data>
      <data key="d2">PSA test is a blood test that measures prostate-specific antigen levels, used to detect possible prostate cancer.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-6232dd9ed168a1113955e7300645338b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Complementary Medicines">
      <data key="d0">Complementary Medicines</data>
      <data key="d1">content</data>
      <data key="d2">Complementary medicines include supplements, vitamins, and herbs that may interact with cancer treatments or affect test results.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Saw Palmetto">
      <data key="d0">Saw Palmetto</data>
      <data key="d1">content</data>
      <data key="d2">Saw palmetto is a herbal supplement that may affect PSA levels and should be disclosed to healthcare providers.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="St. Johns Wort">
      <data key="d0">St. Johns Wort</data>
      <data key="d1">content</data>
      <data key="d2">St. John’s Wort is a herbal supplement that may interfere with cancer treatments and should be reported to medical teams.&lt;SEP&gt;St. John’s Wort is an herbal supplement commonly used for mood support.</data>
      <data key="d3">chunk-697db1653f51e966e79b92eefeb01ec6&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Therapy">
      <data key="d0">Therapy</data>
      <data key="d1">concept</data>
      <data key="d2">Therapy refers to medical treatment typically lasting 3 to 6 months, depending on the regimen and risk of cancer recurrence.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Surveillance Follow-up Testing">
      <data key="d0">Surveillance Follow-up Testing</data>
      <data key="d1">method</data>
      <data key="d2">Surveillance follow-up testing is used to detect new cancer growth early after treatment, involving procedures like colonoscopies.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Stage 1 Colon Cancer">
      <data key="d0">Stage 1 Colon Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Stage 1 colon cancer is a type of cancer that requires surveillance testing, including colonoscopies, after treatment.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839776</data>
      <data key="d6" />
    </node>
    <node id="Stage 2 Colon Cancer">
      <data key="d0">Stage 2 Colon Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Stage 2 colon cancer requires additional surveillance methods beyond colonoscopy, such as physical exams and blood tests.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839776</data>
      <data key="d6" />
    </node>
    <node id="Stage 3 Colon Cancer">
      <data key="d0">Stage 3 Colon Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Stage 3 colon cancer involves more comprehensive surveillance, including physical exams, CEA blood tests, and CT scans.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839776</data>
      <data key="d6" />
    </node>
    <node id="Carcinoembryonic Antigen (CEA) Blood Test">
      <data key="d0">Carcinoembryonic Antigen (CEA) Blood Test</data>
      <data key="d1">procedure</data>
      <data key="d2">The CEA blood test is used in the surveillance of stages 2 and 3 colon cancer to monitor for possible recurrence.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839776</data>
      <data key="d6" />
    </node>
    <node id="Nasopharyngeal Carcinoma (NPC)">
      <data key="d0">Nasopharyngeal Carcinoma (NPC)</data>
      <data key="d1">condition</data>
      <data key="d2">Nasopharyngeal carcinoma is a rare type of cancer affecting the nasopharynx, often associated with squamous cell carcinoma.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839776</data>
      <data key="d6" />
    </node>
    <node id="Pharynx">
      <data key="d0">Pharynx</data>
      <data key="d1">location</data>
      <data key="d2">The pharynx is a hollow, muscular tube in the neck that serves as a passageway for air and food.&lt;SEP&gt;The pharynx is the part of the throat located behind the mouth and nasal cavity.&lt;SEP&gt;The pharynx is a muscular tube in the neck that connects the nasal cavity to the larynx and esophagus, divided into three parts: nasopharynx, oropharynx, and hypopharynx.</data>
      <data key="d3">chunk-c9383db20cd696688798a193862cb5cc&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b&lt;SEP&gt;chunk-c622c677deca24391324ecd5f16ce4a3</data>
