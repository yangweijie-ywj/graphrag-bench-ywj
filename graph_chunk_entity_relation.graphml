    <node id="Thyroidectomy">
      <data key="d0">Thyroidectomy</data>
      <data key="d1">method</data>
      <data key="d2">Thyroidectomy is a surgical procedure involving the removal of all or part of the thyroid gland.&lt;SEP&gt;Thyroidectomy is a surgical procedure to remove all or part of the thyroid gland.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-1e017cd4fd8af1ebbcb582a93fbfe1ea&lt;SEP&gt;chunk-9d383e4798456aa46e381fd2b02f6f96</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839706</data>
      <data key="d6" />
    </node>
    <node id="Pathologic Exam">
      <data key="d0">Pathologic Exam</data>
      <data key="d1">method</data>
      <data key="d2">A pathologic exam is a laboratory analysis of tissue samples to determine the presence and nature of disease.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839706</data>
      <data key="d6" />
