    <node id="CBC">
      <data key="d0">CBC</data>
      <data key="d1">data</data>
      <data key="d2">CBC stands for complete blood count, a blood test used to assess overall health and detect abnormalities.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839847</data>
      <data key="d6" />
    </node>
    <node id="Tumor Marker Tests">
      <data key="d0">Tumor Marker Tests</data>
      <data key="d1">data</data>
      <data key="d2">Tumor marker tests are blood tests that detect substances produced by cancer cells or the body in response to cancer.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
      <data key="d4">unknown_source</data>
