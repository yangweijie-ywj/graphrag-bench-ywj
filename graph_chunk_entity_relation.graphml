      <data key="d1">concept</data>
      <data key="d2">Chemotherapy cycles refer to the structured administration of chemotherapy drugs, allowing the body time to recover between treatments.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839838</data>
      <data key="d6" />
