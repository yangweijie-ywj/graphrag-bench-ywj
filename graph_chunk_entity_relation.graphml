      <data key="d0">Genetic Hemochromatosis</data>
      <data key="d1">disease</data>
      <data key="d2">Genetic Hemochromatosis is an inherited condition that causes excessive iron absorption, leading to organ damage.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
