    <node id="Osteoporosis">
      <data key="d0">Osteoporosis</data>
      <data key="d1">disease</data>
      <data key="d2">Osteoporosis is a long-term risk due to low estrogen levels, leading to bone loss.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
