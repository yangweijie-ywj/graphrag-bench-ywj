      <data key="d0">Mismatch Repair Genes</data>
      <data key="d1">concept</data>
      <data key="d2">Mismatch repair genes are responsible for fixing damaged DNA and are tested for mutations in rectal cancer patients.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839685</data>
