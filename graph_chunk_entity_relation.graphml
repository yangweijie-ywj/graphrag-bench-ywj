    <node id="Swallowing Therapist">
      <data key="d0">Swallowing Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A Swallowing Therapist is a professional who assists patients with difficulty swallowing.&lt;SEP&gt;A swallowing therapist is a professional who assesses and treats difficulty in swallowing.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
