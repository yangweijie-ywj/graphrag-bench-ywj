    </node>
    <node id="Centrocytes">
      <data key="d0">Centrocytes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Centrocytes are B cells found in the light zone of germinal centers, which are smaller and divide less frequently.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839784</data>
      <data key="d6" />
    </node>
    <node id="Centroblasts">
      <data key="d0">Centroblasts</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Centroblasts are B cells found in the dark zone of germinal centers, which are larger and divide more rapidly.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839784</data>
      <data key="d6" />
