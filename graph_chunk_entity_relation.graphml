      <data key="d6" />
    </node>
    <node id="Normal Cells">
      <data key="d0">Normal Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Normal Cells are healthy cells that function properly in the body.&lt;SEP&gt;Normal cells are healthy cells that follow the body's rules for growth and death, in contrast to cancer cells.&lt;SEP&gt;Normal cells are healthy cells that function properly within the body's tissues and organs.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-a158766f46bf752d6cdfe95c92f14547&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
