    <node id="AML Mutation Testing">
      <data key="d0">AML Mutation Testing</data>
      <data key="d1">method</data>
      <data key="d2">AML mutation testing uses methods like karyotype, FISH, NGS, and PCR to detect genetic changes in AML cells.</data>
