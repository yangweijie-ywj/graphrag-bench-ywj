    </node>
    <node id="Cardia">
      <data key="d0">Cardia</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The cardia is the opening of the esophagus into the stomach.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839736</data>
      <data key="d6" />
    </node>
    <node id="Fundus">
      <data key="d0">Fundus</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The fundus is the upper part of the stomach that stores undigested food and gases.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839736</data>
