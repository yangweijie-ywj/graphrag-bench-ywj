    <node id="Grade Group">
      <data key="d0">Grade Group</data>
      <data key="d1">concept</data>
      <data key="d2">The Grade Group is a classification system that organizes Gleason scores into five categories, indicating the aggressiveness of prostate cancer.&lt;SEP&gt;Grade Group is a classification system used to assess the severity of prostate cancer based on Gleason scores.&lt;SEP&gt;Grade group is a classification system used to assess the aggressiveness of prostate cancer based on biopsy results.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa&lt;SEP&gt;chunk-1c7418fb993bb3daa95d8563909da1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839712</data>
