    <node id="Difficulty Eating">
      <data key="d0">Difficulty Eating</data>
      <data key="d1">symptom</data>
      <data key="d2">Difficulty eating is a symptom of ovarian cancer, often leading to reduced food intake.&lt;SEP&gt;Difficulty Eating is a symptom of ovarian cancer where the patient has trouble consuming food.</data>
      <data key="d3">chunk-ae40f53e9d867c255e1e6901f5cfb058&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154</data>
