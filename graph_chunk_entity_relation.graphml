    <node id="Hot Flashes">
      <data key="d0">Hot Flashes</data>
      <data key="d1">symptom</data>
      <data key="d2">Hot flashes are a common symptom of menopause, characterized by sudden feelings of heat.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839683</data>
