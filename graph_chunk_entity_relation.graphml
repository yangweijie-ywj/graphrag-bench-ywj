      <data key="d0">Tunica Adventitia</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Tunica adventitia is the outermost layer of the esophagus, made of connective tissue.&lt;SEP&gt;Tunica Adventitia is the outermost layer of the esophagus wall, composed of connective tissue.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
