    </node>
    <node id="Pelvic Exam">
      <data key="d0">Pelvic Exam</data>
      <data key="d1">method</data>
      <data key="d2">A pelvic exam involves checking the reproductive organs for signs of disease or abnormality.&lt;SEP&gt;A pelvic exam is a medical examination of the female reproductive system.</data>
      <data key="d3">chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
