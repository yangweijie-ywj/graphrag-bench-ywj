    <node id="Surgical Oncologist">
      <data key="d0">Surgical Oncologist</data>
      <data key="d1">person</data>
      <data key="d2">A surgical oncologist specializes in surgically removing cancerous tissues.&lt;SEP&gt;A surgical oncologist performs operations to remove cancerous tissue.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
