    </node>
    <node id="CLL Cells">
      <data key="d0">CLL Cells</data>
      <data key="d1">concept</data>
      <data key="d2">CLL cells are cancerous B cells that have unique features used to plan personalized treatment.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839818</data>
