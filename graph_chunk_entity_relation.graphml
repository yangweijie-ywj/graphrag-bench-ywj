      <data key="d6" />
    </node>
    <node id="Neurological Exam">
      <data key="d0">Neurological Exam</data>
      <data key="d1">method</data>
      <data key="d2">A neurological exam is a test used to assess a patient's nervous system function.&lt;SEP&gt;A neurological exam assesses alertness, balance, coordination, reflexes, and other senses to aid in diagnosis.&lt;SEP&gt;A neurological exam involves tests to assess alertness, thinking, balance, and other functions.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-49c7ff3a71e74b3f0eb59258541e739e&lt;SEP&gt;chunk-a0d4d6b091e033fd01aa721422b68ef5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839763</data>
      <data key="d6" />
    </node>
    <node id="Remission">
      <data key="d0">Remission</data>
      <data key="d1">concept</data>
      <data key="d2">Remission refers to a state where leukemia symptoms are reduced or absent.&lt;SEP&gt;Remission is a state in which the signs and symptoms of a disease are reduced or no longer present.&lt;SEP&gt;Remission refers to a period when there are no symptoms or signs of cancer.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23&lt;SEP&gt;chunk-db4e8318949a3fda5683c53985c6af05&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
