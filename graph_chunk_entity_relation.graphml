    </node>
    <node id="Diffuse Type Adenocarcinoma">
      <data key="d0">Diffuse Type Adenocarcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">The diffuse type of adenocarcinoma appears scattered and is less common than the intestinal type.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839737</data>
      <data key="d6" />
