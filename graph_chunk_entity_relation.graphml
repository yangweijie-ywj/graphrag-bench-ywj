    <node id="Testing for ALL">
      <data key="d0">Testing for ALL</data>
      <data key="d1">concept</data>
      <data key="d2">Testing for ALL involves various medical procedures to diagnose and determine the treatment plan.&lt;SEP&gt;Testing for ALL involves various medical procedures to diagnose and assess the condition, including blood tests, imaging studies, and genetic testing.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585</data>
      <data key="d4">unknown_source</data>
