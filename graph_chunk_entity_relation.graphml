    <node id="SCLC">
      <data key="d0">SCLC</data>
      <data key="d1">concept</data>
      <data key="d2">SCLC is a specific type of lung cancer, distinct from NSCLC, with unique characteristics and risk factors.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
