    <node id="Prognostic Staging">
      <data key="d0">Prognostic Staging</data>
      <data key="d1">concept</data>
      <data key="d2">Prognostic staging includes anatomic staging plus additional factors such as tumor grade and biomarker status to predict outcomes.</data>
