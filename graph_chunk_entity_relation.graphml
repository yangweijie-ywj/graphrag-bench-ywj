    <node id="Pulmonologist">
      <data key="d0">Pulmonologist</data>
      <data key="d1">person</data>
      <data key="d2">A Pulmonologist is a doctor who specializes in lung diseases and conditions.&lt;SEP&gt;A Pulmonologist is a medical doctor specializing in lung diseases and respiratory conditions.&lt;SEP&gt;A pulmonologist is a physician specializing in the diagnosis and treatment of lung diseases.</data>
