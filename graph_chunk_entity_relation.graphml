      <data key="d5">1772839812</data>
      <data key="d6" />
    </node>
    <node id="Shared Decisions">
      <data key="d0">Shared Decisions</data>
      <data key="d1">concept</data>
      <data key="d2">Shared decisions involve patients and care teams working together to choose the most appropriate treatment options.&lt;SEP&gt;Shared decisions involve patients and their care teams working together to make informed choices about treatment.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
