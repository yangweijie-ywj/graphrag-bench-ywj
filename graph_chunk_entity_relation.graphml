    <node id="Nasolaryngoscopy">
      <data key="d0">Nasolaryngoscopy</data>
      <data key="d1">procedure</data>
      <data key="d2">Nasolaryngoscopy is a type of fiberoptic laryngoscopy involving a flexible scope passed through the nose into the throat.&lt;SEP&gt;Nasolaryngoscopy is a type of laryngoscopy that uses a flexible scope passed through the nose to examine the throat.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd</data>
