    <node id="Renal Ultrasound">
      <data key="d0">Renal Ultrasound</data>
      <data key="d1">method</data>
      <data key="d2">Renal ultrasound is a non-invasive imaging technique that uses sound waves to examine the kidneys, ureters, and bladder.&lt;SEP&gt;A renal ultrasound is a non-invasive imaging technique used to examine the kidneys and urinary tract using sound waves.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3</data>
      <data key="d4">unknown_source</data>
