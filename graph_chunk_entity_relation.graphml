      <data key="d0">Bone-Strengthening Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Bone-strengthening therapy is a treatment used to prevent or reduce bone loss caused by cancer or its treatment.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839810</data>
