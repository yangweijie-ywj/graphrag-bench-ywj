    <edge source="Ultrasound" target="Fallopian Tubes">
      <data key="d7">1.0</data>
      <data key="d8">The fallopian tubes are visualized during an ultrasound to detect abnormalities.</data>
      <data key="d9">anatomical structure,imaging target</data>
