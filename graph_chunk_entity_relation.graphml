    </node>
    <node id="Tumor Return After Treatment">
      <data key="d0">Tumor Return After Treatment</data>
      <data key="d1">condition</data>
      <data key="d2">Tumor return after treatment refers to cancer that reappears following initial treatment.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
