    <node id="Anemia">
      <data key="d0">Anemia</data>
      <data key="d1">concept</data>
      <data key="d2">Anemia is a condition characterized by a lack of healthy red blood cells.&lt;SEP&gt;Anemia is a condition characterized by low red blood cell count and is a potential complication of CLL.</data>
      <data key="d3">chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
