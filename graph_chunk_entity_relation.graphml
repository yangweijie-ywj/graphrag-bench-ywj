      <data key="d6" />
    </node>
    <node id="Clinical Trial Eligibility">
      <data key="d0">Clinical Trial Eligibility</data>
      <data key="d1">concept</data>
      <data key="d2">Clinical trial eligibility refers to the criteria patients must meet to participate in a clinical trial.&lt;SEP&gt;Clinical trial eligibility refers to the criteria determining whether a patient can participate in a specific research study.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
      <data key="d4">unknown_source</data>
