    <node id="Adrenal Cancer">
      <data key="d0">Adrenal Cancer</data>
      <data key="d1">disease</data>
      <data key="d2">Adrenal cancer is a rare cancer that starts in one or both of the adrenal glands and can be cured if caught early.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
