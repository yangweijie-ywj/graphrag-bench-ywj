    <node id="Autoimmune Reaction">
      <data key="d0">Autoimmune Reaction</data>
      <data key="d1">symptom</data>
      <data key="d2">An autoimmune reaction is a possible side effect of immunotherapy, where the immune system attacks healthy cells.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab</data>
      <data key="d4">unknown_source</data>
