    <node id="Cancer Center">
      <data key="d0">Cancer Center</data>
      <data key="d1">location</data>
      <data key="d2">A cancer center is a facility where patients receive specialized care and support, including assistance with financial and insurance stresses.&lt;SEP&gt;A cancer center is a medical facility that provides specialized care and treatment for cancer patients.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f&lt;SEP&gt;chunk-d0f15711706bc171fed17a7fab91b4b6</data>
