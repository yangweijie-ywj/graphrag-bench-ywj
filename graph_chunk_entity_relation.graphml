    <node id="Stage II Anal Cancer">
      <data key="d0">Stage II Anal Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Stage II anal cancer is divided into two substages based on tumor size, with no lymph node or distant metastasis.</data>
      <data key="d3">chunk-06384634b72466c480713ee8d57f25ed</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839781</data>
