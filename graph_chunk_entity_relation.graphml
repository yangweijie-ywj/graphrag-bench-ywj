    </node>
    <node id="Anti-Androgens">
      <data key="d0">Anti-Androgens</data>
      <data key="d1">method</data>
      <data key="d2">Anti-androgens are medications that block the effects of androgens like testosterone in the body.</data>
      <data key="d3">chunk-53c0ac935ec10ce8a0839db4ad053ad1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839785</data>
