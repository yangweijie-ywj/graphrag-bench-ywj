    <node id="Continent Urinary Diversion">
      <data key="d0">Continent Urinary Diversion</data>
      <data key="d1">procedure</data>
      <data key="d2">Continent urinary diversion is a type of urinary surgery that allows urine to be stored internally and drained periodically.</data>
