    <node id="NCCN Patient Guides for Cancer App">
      <data key="d0">NCCN Patient Guides for Cancer App</data>
      <data key="d1">content</data>
      <data key="d2">The NCCN Patient Guides for Cancer App is a mobile application offering guidance on cancer-related topics.&lt;SEP&gt;NCCN Patient Guides for Cancer App is a mobile application offering guidance on cancer treatment and management.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144</data>
