    </node>
    <node id="Adrenal Glands">
      <data key="d0">Adrenal Glands</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Adrenal glands are small, yellow glands located on top of each kidney, responsible for producing hormones.&lt;SEP&gt;Adrenal glands are small, yellow glands located near the kidneys that play a key role in the endocrine system by producing hormones.&lt;SEP&gt;Adrenal glands are endocrine glands located on top of the kidneys, producing hormones.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
      <data key="d4">unknown_source</data>
