    </node>
    <node id="Mohs Procedure">
      <data key="d0">Mohs Procedure</data>
      <data key="d1">method</data>
      <data key="d2">Mohs procedure is a surgical technique used to remove skin cancer with high precision, often followed by a skin graft.</data>
