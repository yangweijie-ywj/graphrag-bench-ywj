    <node id="Hypomethylating Agents">
      <data key="d0">Hypomethylating Agents</data>
      <data key="d1">method</data>
      <data key="d2">Hypomethylating agents block methyl groups from binding to DNA, allowing genes to function properly.&lt;SEP&gt;Hypomethylating agents are drugs that block methyl groups from binding to DNA, helping to turn silenced genes back on.&lt;SEP&gt;Hypomethylating agents are drugs that reduce methyl groups on DNA, allowing silenced genes to be expressed.</data>
      <data key="d3">chunk-8333423c91919d7adde114b8286cca7e&lt;SEP&gt;chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-53afdc6713818c4177b64a712ecce11b</data>
