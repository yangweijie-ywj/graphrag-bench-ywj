    <node id="Muscularis Propria">
      <data key="d0">Muscularis Propria</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Muscularis propria is a thick layer of muscle responsible for peristalsis.&lt;SEP&gt;Muscularis Propria is the muscular layer of the esophagus wall responsible for peristalsis.&lt;SEP&gt;Muscularis propria is the third layer of the colon wall composed of muscle tissue.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-b5cfcc365cd093374564eb27dcbf5b82&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
