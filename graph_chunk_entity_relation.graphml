    <node id="Liver Cancer">
      <data key="d0">Liver Cancer</data>
      <data key="d1">disease</data>
      <data key="d2">Liver cancer is cancer that starts in the liver and includes primary and secondary types.&lt;SEP&gt;Liver cancer is a type of cancer that originates in the liver and can spread to other parts of the body.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
