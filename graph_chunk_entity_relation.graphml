    <node id="Carbon Dioxide">
      <data key="d0">Carbon Dioxide</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Carbon dioxide is a waste gas produced by the body's cells and expelled from the body through the lungs.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
