    </node>
    <node id="Fertility (All Genders)">
      <data key="d0">Fertility (All Genders)</data>
      <data key="d1">concept</data>
      <data key="d2">Fertility refers to the ability to conceive or reproduce, and is relevant for all genders during cancer treatment.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
