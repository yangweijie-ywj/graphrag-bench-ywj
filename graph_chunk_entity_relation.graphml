      <data key="d0">Support Services</data>
      <data key="d1">concept</data>
      <data key="d2">Support services are resources and assistance provided to help patients cope with the emotional and practical aspects of cancer.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839813</data>
