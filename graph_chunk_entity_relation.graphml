    <node id="Indirect Laryngoscopy">
      <data key="d0">Indirect Laryngoscopy</data>
      <data key="d1">procedure</data>
      <data key="d2">Indirect laryngoscopy uses a mirror and light to examine the back of the throat and vocal cords.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839825</data>
