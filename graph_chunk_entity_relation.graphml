    <node id="Large Bowel">
      <data key="d0">Large Bowel</data>
      <data key="d1">location</data>
      <data key="d2">The large bowel is the final part of the digestive tract, with the rectum being its last segment.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
      <data key="d4">unknown_source</data>
