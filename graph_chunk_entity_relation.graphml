    <node id="Trachea">
      <data key="d0">Trachea</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The trachea, also known as the windpipe, is a tube that carries air from the throat to the lungs.&lt;SEP&gt;The trachea, also known as the windpipe, is a tube that leads from the throat to the lungs.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d&lt;SEP&gt;chunk-5a84075aaac61b0ad85e5f811fc4f24b</data>
