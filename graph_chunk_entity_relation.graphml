    <node id="Direct Laryngoscopy">
      <data key="d0">Direct Laryngoscopy</data>
      <data key="d1">procedure</data>
      <data key="d2">Direct laryngoscopy is a more detailed exam performed under general anesthesia in an operating room.&lt;SEP&gt;Direct laryngoscopy is a detailed exam performed under general anesthesia to examine deeper areas of the throat and take tissue samples.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-0739b33959299ea67072f390ce38bffd</data>
