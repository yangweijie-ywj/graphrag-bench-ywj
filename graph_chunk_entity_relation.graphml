      <data key="d7">1.0</data>
      <data key="d8">Ultrasound is one of the diagnostic methods used in liver cancer screening.</data>
      <data key="d9">diagnostic method</data>
      <data key="d10">chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
