    <node id="Follicular Lymphoma">
      <data key="d0">Follicular Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">Follicular lymphoma (FL) is a slow-growing non-Hodgkin lymphoma that develops from B lymphocytes.&lt;SEP&gt;Follicular Lymphoma is a type of slow-growing lymphoma that typically forms tumors in the lymph nodes.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-829d6b7840e9f2c8d97d22d2ce2c43c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839783</data>
      <data key="d6" />
    </node>
    <node id="B Lymphocytes">
      <data key="d0">B Lymphocytes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">B lymphocytes are a type of white blood cell that produces antibodies to fight infections and cancer.&lt;SEP&gt;B lymphocytes produce antibodies to fight infections.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839783</data>
      <data key="d6" />
    </node>
    <node id="T Lymphocytes">
      <data key="d0">T Lymphocytes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">T lymphocytes are a type of white blood cell that helps fight infections, cancer, and regulate immune responses.&lt;SEP&gt;T lymphocytes help fight infections, kill tumor cells, and regulate immune responses.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3&lt;SEP&gt;chunk-a99a89bec88823cedf4c1f0cd1a78e81</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839783</data>
      <data key="d6" />
    </node>
    <node id="Germinal Centers">
      <data key="d0">Germinal Centers</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Germinal centers are temporary structures in lymph nodes that form in response to infection or inflammation.</data>
      <data key="d3">chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839783</data>
