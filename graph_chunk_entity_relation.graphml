    <node id="Ribs">
      <data key="d0">Ribs</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Ribs are bones that form the rib cage and protect internal organs, including the heart and lungs.&lt;SEP&gt;Ribs are bones that protect internal organs and provide structural support to the chest area.</data>
      <data key="d3">chunk-a06038ec84f20e873b9e275a23aea8d9&lt;SEP&gt;chunk-1dc8d8e5ed4f165f3e56305a7644ba05&lt;SEP&gt;chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
