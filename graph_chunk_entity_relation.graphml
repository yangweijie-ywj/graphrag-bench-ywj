    <node id="Secondary Liver Cancer">
      <data key="d0">Secondary Liver Cancer</data>
      <data key="d1">disease</data>
      <data key="d2">Secondary liver cancer is when cancer from another part of the body spreads to the liver.&lt;SEP&gt;Secondary liver cancer is cancer that spreads to the liver from another part of the body.</data>
      <data key="d3">chunk-d4bc8b1b941d18ac455e5f255e1df8c1&lt;SEP&gt;chunk-84367cc8f7a94b97b4b66a1ca127c15f</data>
