    <node id="Metastatic Cervical Cancer">
      <data key="d0">Metastatic Cervical Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Metastatic cervical cancer refers to cervical cancer that has spread beyond the original site to other parts of the body.&lt;SEP&gt;Metastatic cervical cancer is a type of cancer that has spread beyond the cervix to other parts of the body.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea</data>
