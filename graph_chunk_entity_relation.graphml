      <data key="d0">Nicotine Addiction</data>
      <data key="d1">concept</data>
      <data key="d2">Nicotine addiction is a psychological and physical dependence on nicotine found in tobacco products.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
