      <data key="d0">LHRH Agonists</data>
      <data key="d1">concept</data>
      <data key="d2">LHRH agonists are drugs that block the production of LHRH, thereby stopping the ovaries from making hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839755</data>
      <data key="d6" />
    </node>
    <node id="Aromatase Inhibitors">
      <data key="d0">Aromatase Inhibitors</data>
      <data key="d1">method</data>
      <data key="d2">Aromatase inhibitors are drugs that prevent the conversion of androgens into estrogen.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408</data>
      <data key="d4">unknown_source</data>
