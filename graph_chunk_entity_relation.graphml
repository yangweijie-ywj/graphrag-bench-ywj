    <node id="Online Patient Portals">
      <data key="d0">Online Patient Portals</data>
      <data key="d1">content</data>
      <data key="d2">Online patient portals are digital platforms that allow patients to access their medical records and test results.&lt;SEP&gt;Online patient portals allow patients to access their test results and other medical information.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15&lt;SEP&gt;chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d&lt;SEP&gt;chunk-38185832d6395b9952def9a72ecc339d</data>
      <data key="d4">unknown_source</data>
