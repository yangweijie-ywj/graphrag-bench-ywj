    <node id="Imaging Study">
      <data key="d0">Imaging Study</data>
      <data key="d1">method</data>
      <data key="d2">Imaging studies use technology to create visual representations of the body's internal structures, helping to determine treatment plans for cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
