    <node id="Tinnitus">
      <data key="d0">Tinnitus</data>
      <data key="d1">concept</data>
      <data key="d2">Tinnitus is a side effect of cisplatin, characterized by ringing in the ears.&lt;SEP&gt;Tinnitus, or ringing in the ears, is a possible side effect of cisplatin treatment.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-d04ad65c55d0dbbee5061cf3b24030ef</data>
