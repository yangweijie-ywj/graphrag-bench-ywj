    <node id="Eastern Cooperative Oncology Group Score">
      <data key="d0">Eastern Cooperative Oncology Group Score</data>
      <data key="d1">method</data>
      <data key="d2">The Eastern Cooperative Oncology Group score is a tool used to assess a patient's performance status.&lt;SEP&gt;The ECOG score is a method used to rate a patient's general health and functional status.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) score is a scale used to assess a patient's performance status.</data>
      <data key="d3">chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144</data>
