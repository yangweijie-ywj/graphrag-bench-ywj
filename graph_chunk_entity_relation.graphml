      <data key="d0">Primary Care Physician (PCP)</data>
      <data key="d1">person</data>
      <data key="d2">A primary care physician is a medical doctor who provides comprehensive, ongoing care to patients.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839813</data>
      <data key="d6" />
