    <node id="Alternative Chemotherapy Drug">
      <data key="d0">Alternative Chemotherapy Drug</data>
      <data key="d1">artifact</data>
      <data key="d2">An alternative chemotherapy drug may be used if a patient cannot tolerate cisplatin due to kidney issues.</data>
