      <data key="d5">1772839838</data>
      <data key="d6" />
    </node>
    <node id="Eye Irritation">
      <data key="d0">Eye Irritation</data>
      <data key="d1">concept</data>
      <data key="d2">Eye irritation is a possible side effect of intraocular chemotherapy, requiring close monitoring.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839838</data>
