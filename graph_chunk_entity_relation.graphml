      <data key="d13" />
    </edge>
    <edge source="Ultrasound" target="Ovarian Cancer">
      <data key="d7">2.0</data>
      <data key="d8">Ultrasound is commonly used to detect ovarian tumors and assess their characteristics.&lt;SEP&gt;Ultrasound is often the first imaging test used in the diagnosis of ovarian cancer.</data>
      <data key="d9">diagnostic method,diagnostic tool,imaging test</data>
      <data key="d10">chunk-e5406c28b41e499fad4ae44f2c44fdd7&lt;SEP&gt;chunk-96238b4b361e393ff452a09d1ce26154</data>
