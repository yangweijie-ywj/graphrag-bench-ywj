    </node>
    <node id="Cutaneous T-Cell Lymphoma">
      <data key="d0">Cutaneous T-Cell Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">Cutaneous T-cell lymphoma (CTCL) is a type of PCL that develops from abnormal T cells.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
      <data key="d4">unknown_source</data>
