    <node id="PSA Level">
      <data key="d0">PSA Level</data>
      <data key="d1">data</data>
      <data key="d2">PSA level is a measure of prostate-specific antigen in the bloodstream, used to assess the risk of prostate cancer.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839741</data>
