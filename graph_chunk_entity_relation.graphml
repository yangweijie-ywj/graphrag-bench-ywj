      <data key="d0">Pfizer Inc.</data>
      <data key="d1">organization</data>
      <data key="d2">Pfizer Inc. is a corporate supporter of the NCCN Guidelines for Patients.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839757</data>
      <data key="d6" />
    </node>
    <node id="Hodgkin Lymphoma">
      <data key="d0">Hodgkin Lymphoma</data>
      <data key="d1">concept</data>
      <data key="d2">Hodgkin lymphoma is a type of cancer that starts in lymph nodes and is highly curable.&lt;SEP&gt;Hodgkin Lymphoma is a type of cancer that affects the lymphatic system, characterized by the presence of Reed-Sternberg cells.&lt;SEP&gt;Hodgkin lymphoma is a type of lymphatic cancer characterized by the presence of Reed-Sternberg cells.&lt;SEP&gt;Hodgkin lymphoma is another type of cancer that can develop from CLL in rare cases.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-098a64d7118fc8e1eb3e91ba0124258c&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839757</data>
      <data key="d6" />
    </node>
    <node id="Reed-Sternberg Cells">
      <data key="d0">Reed-Sternberg Cells</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Reed-Sternberg cells are large lymphocytes found in Hodgkin lymphoma, identified under a microscope.&lt;SEP&gt;Reed-Sternberg cells are large lymphocytes characteristic of classic Hodgkin lymphoma.&lt;SEP&gt;Reed-Sternberg cells are large, abnormal lymphocytes found in Hodgkin lymphoma.</data>
      <data key="d3">chunk-64f36a4a5be80c8fa51631db16e52b85&lt;SEP&gt;chunk-8ba71a5181f3814dffb21d3399441bea&lt;SEP&gt;chunk-d67bee20d5e5400994f8c8f03052dd06</data>
