    <node id="Speech Therapist">
      <data key="d0">Speech Therapist</data>
      <data key="d1">person</data>
      <data key="d2">A Speech Therapist is a professional who helps patients with speech and swallowing difficulties.&lt;SEP&gt;A Speech Therapist is a professional who helps patients improve communication and swallowing abilities.&lt;SEP&gt;A speech therapist is a professional who evaluates and treats speech and swallowing difficulties.</data>
