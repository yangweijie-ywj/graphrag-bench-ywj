    <node id="Risk Factor">
      <data key="d0">Risk Factor</data>
      <data key="d1">concept</data>
      <data key="d2">A risk factor is anything that increases the likelihood of developing a disease, such as liver cancer.&lt;SEP&gt;A risk factor is anything that increases the chances of developing liver cancer.</data>
      <data key="d3">chunk-5fdcf47f3da06d3e0213112c96eb93d4&lt;SEP&gt;chunk-d4bc8b1b941d18ac455e5f255e1df8c1</data>
