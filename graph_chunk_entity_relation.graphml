    </edge>
    <edge source="Ultrasound" target="Sound Waves">
      <data key="d7">1.0</data>
      <data key="d8">Ultrasound uses high-energy sound waves to create images of the body's internal structures.</data>
      <data key="d9">diagnostic tool,imaging technology</data>
