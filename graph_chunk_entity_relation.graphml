    <node id="Myeloid Growth Factors">
      <data key="d0">Myeloid Growth Factors</data>
      <data key="d1">artifact</data>
      <data key="d2">Myeloid growth factors are medications used to stimulate the production of white blood cells in cancer patients.&lt;SEP&gt;Myeloid growth factors are treatments that help increase white blood cell counts.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
