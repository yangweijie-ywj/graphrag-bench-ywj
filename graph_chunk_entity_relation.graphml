    <node id="Microsatellite Stable (MSS)">
      <data key="d0">Microsatellite Stable (MSS)</data>
      <data key="d1">concept</data>
      <data key="d2">MSS refers to tumors with normal mismatch repair function, contrasting with dMMR/MSI-H.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
