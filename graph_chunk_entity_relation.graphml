    <edge source="Oropharynx" target="Throat (Oropharynx)">
      <data key="d7">1.0</data>
      <data key="d8">The throat (oropharynx) is the anatomical area that includes the oropharynx.</data>
      <data key="d9">anatomical relation,focus area</data>
