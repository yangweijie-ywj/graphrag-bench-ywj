    <node id="Ileal Conduit">
      <data key="d0">Ileal Conduit</data>
      <data key="d1">procedure</data>
      <data key="d2">Ileal conduit is a urinary diversion procedure that uses a segment of the small intestine to redirect urine.&lt;SEP&gt;Ileal conduit is a type of urinary diversion that uses a section of the small intestine to create a tube for urine drainage.</data>
      <data key="d3">chunk-13e723cb8b0af4bcf2f1b0fd37912cb2&lt;SEP&gt;chunk-9d0e32bdc49dbab9c2c953abf363e317</data>
