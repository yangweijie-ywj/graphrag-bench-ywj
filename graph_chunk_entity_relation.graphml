    <node id="Risk Assessment">
      <data key="d0">Risk Assessment</data>
      <data key="d1">concept</data>
      <data key="d2">Risk assessment is the process of evaluating factors that determine the likelihood of cancer recurrence or spread.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
