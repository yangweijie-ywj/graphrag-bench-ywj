    <node id="Scalp">
      <data key="d0">Scalp</data>
      <data key="d1">location</data>
      <data key="d2">The scalp is a specific area where radiation therapy may lead to poor wound healing after surgery.&lt;SEP&gt;The scalp is the skin covering the head, often involved in surgical procedures such as biopsies.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-ffc3446f8ec092af24a460bda94f772f</data>
