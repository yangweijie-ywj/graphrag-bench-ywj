      <data key="d6" />
    </node>
    <node id="Anal Canal">
      <data key="d0">Anal Canal</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The anal canal is the short passage connecting the rectum to the anal opening and is a common site for anal cancer.&lt;SEP&gt;The anal canal is the tube-like structure that connects the rectum to the anal opening and is a site where anal cancer can originate.&lt;SEP&gt;The anal canal is a small section of the bowel between the rectum and the anus.&lt;SEP&gt;The section of the large intestine connecting the rectum and the anal opening.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3&lt;SEP&gt;chunk-b0bad5ee25cb854c10bdbc9d33b54a1a&lt;SEP&gt;chunk-06384634b72466c480713ee8d57f25ed&lt;SEP&gt;chunk-f2a44e885faf856aa579d824b3cd85e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839734</data>
      <data key="d6" />
    </node>
    <node id="Anal Sphincter">
      <data key="d0">Anal Sphincter</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A ring-shaped muscle around the anus that controls its opening and closing.</data>
      <data key="d3">chunk-0d4cea71149e0e4157126efdaa0ea3e3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839734</data>
