    <node id="BCR::ABL1-negative B-ALL">
      <data key="d0">BCR::ABL1-negative B-ALL</data>
      <data key="d1">concept</data>
      <data key="d2">BCR::ABL1-negative B-ALL is a subtype of B-cell acute lymphoblastic leukemia that does not have the BCR::ABL1 gene mutation.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
