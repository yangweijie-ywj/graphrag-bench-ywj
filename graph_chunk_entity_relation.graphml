    <node id="Geriatrician">
      <data key="d0">Geriatrician</data>
      <data key="d1">person</data>
      <data key="d2">A geriatrician specializes in the care of elderly patients, including those with cancer.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839722</data>
