    <node id="RNA">
      <data key="d0">RNA</data>
      <data key="d1">data</data>
      <data key="d2">RNA is a molecule involved in gene expression and can be analyzed using PCR techniques.&lt;SEP&gt;RNA is a molecule involved in the process of protein synthesis.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae</data>
      <data key="d4">unknown_source</data>
