    <node id="Second Cancer">
      <data key="d0">Second Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">A second cancer is a rare long-term side effect of radiation therapy, more common in young patients many years later.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0</data>
