    <node id="Plastic Surgeon">
      <data key="d0">Plastic Surgeon</data>
      <data key="d1">person</data>
      <data key="d2">A plastic surgeon specializes in breast reconstruction and can provide expert care for patients undergoing this procedure.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
