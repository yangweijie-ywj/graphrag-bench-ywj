    <node id="Standard Treatment">
      <data key="d0">Standard Treatment</data>
      <data key="d1">method</data>
      <data key="d2">Standard treatment refers to the conventional medical care provided for cancer, which may affect eligibility for clinical trials.&lt;SEP&gt;Standard treatment refers to established methods of treating cancer.&lt;SEP&gt;Standard treatment refers to the conventional medical approach used to treat a specific condition, often compared against new treatments in clinical trials.&lt;SEP&gt;Standard treatment refers to established and widely accepted cancer therapies that are routinely used in clinical practice.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
      <data key="d4">unknown_source</data>
