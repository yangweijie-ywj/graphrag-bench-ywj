    <node id="Circulating Tumor DNA (ctDNA) Testing">
      <data key="d0">Circulating Tumor DNA (ctDNA) Testing</data>
      <data key="d1">method</data>
      <data key="d2">ctDNA testing, also known as a liquid biopsy, detects DNA fragments from tumor cells in the blood.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839686</data>
      <data key="d6" />
    </node>
    <node id="Liquid Biopsy">
      <data key="d0">Liquid Biopsy</data>
      <data key="d1">method</data>
      <data key="d2">A liquid biopsy is a type of ctDNA testing that looks for microscopic cancer cells in the blood after treatment.&lt;SEP&gt;A liquid biopsy is a diagnostic test that analyzes blood samples for cancer cells or genetic material.&lt;SEP&gt;A liquid biopsy is a type of biopsy that involves taking a blood sample to look for cancer cells in the bloodstream.&lt;SEP&gt;A liquid biopsy is a test that looks for small pieces of DNA released by tumor cells into the blood, used for detecting cancer.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d&lt;SEP&gt;chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-975e540ddee1810d43caf8df4adcf205&lt;SEP&gt;chunk-965e5a6bad03f2129a98be4373f99176</data>
      <data key="d4">unknown_source</data>
