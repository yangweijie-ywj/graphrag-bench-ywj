    <node id="Vaginal Atrophy">
      <data key="d0">Vaginal Atrophy</data>
      <data key="d1">condition</data>
      <data key="d2">Vaginal atrophy is a condition where the vaginal lining becomes thin, dry, and inflamed.</data>
