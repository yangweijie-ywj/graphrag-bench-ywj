    <node id="Mismatch Repair Testing">
      <data key="d0">Mismatch Repair Testing</data>
      <data key="d1">method</data>
      <data key="d2">Mismatch repair testing is a procedure to analyze tumor mutations in mismatch repair genes, used to identify biomarkers for treatment planning.</data>
