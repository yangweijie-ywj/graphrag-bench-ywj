      <data key="d6" />
    </node>
    <node id="Hormonal Birth Control">
      <data key="d0">Hormonal Birth Control</data>
      <data key="d1">method</data>
      <data key="d2">Hormonal Birth Control is a type of contraceptive that may or may not be recommended during cancer treatment.&lt;SEP&gt;Hormonal birth control includes methods such as pills or patches that regulate hormones to prevent pregnancy.&lt;SEP&gt;Hormonal birth control is a method of preventing pregnancy using hormones.</data>
      <data key="d3">chunk-0bd86bf8fc82f14fa5f7f51d924514e7&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150&lt;SEP&gt;chunk-5fa7c7369d88ae71c842152510867223</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839721</data>
      <data key="d6" />
    </node>
    <node id="Pancreatic Cancer">
      <data key="d0">Pancreatic Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Pancreatic cancer is a type of cancer that originates in the pancreas and can spread to other parts of the body.&lt;SEP&gt;Pancreatic cancer is a type of cancer that requires multiple tests for diagnosis and treatment planning.&lt;SEP&gt;Pancreatic cancer is a type of cancer that develops in the pancreas, a gland involved in digestion and hormone regulation.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585</data>
