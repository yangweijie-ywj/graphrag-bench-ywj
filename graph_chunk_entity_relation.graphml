    <node id="Imaging Test">
      <data key="d0">Imaging Test</data>
      <data key="d1">method</data>
      <data key="d2">An imaging test is a medical procedure used to visualize internal structures of the body for diagnostic purposes.&lt;SEP&gt;Imaging Test is a medical procedure that uses various techniques to create images of the inside of the body for diagnostic purposes.</data>
      <data key="d3">chunk-9dc281a303d0d4c5300c0c1c45b739ed&lt;SEP&gt;chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-a2778e34af702d49d5e70867726e14b2</data>
