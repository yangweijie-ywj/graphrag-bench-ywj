    <node id="Online Patient Portal">
      <data key="d0">Online Patient Portal</data>
      <data key="d1">artifact</data>
      <data key="d2">An online patient portal is a digital platform that allows patients to access their medical records and test results.&lt;SEP&gt;An online patient portal is a digital platform that allows patients to access their medical test results and communicate with their healthcare team.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203&lt;SEP&gt;chunk-64f36a4a5be80c8fa51631db16e52b85</data>
