    <node id="Endoscopic Tests">
      <data key="d0">Endoscopic Tests</data>
      <data key="d1">method</data>
      <data key="d2">Endoscopic tests are procedures used to examine the digestive tract and detect pancreatic cancer.&lt;SEP&gt;Endoscopic tests are used in the diagnosis of pancreatic cancer.</data>
      <data key="d3">chunk-0fb70c1c798caae12ac2d64e61bcbad4&lt;SEP&gt;chunk-6268b6efa690f6e094e443dca6b4cb52</data>
