    <node id="Electrocardiogram">
      <data key="d0">Electrocardiogram</data>
      <data key="d1">event</data>
      <data key="d2">An electrocardiogram (ECG) records the electrical activity of the heart, revealing heart rate, rhythm, and potential abnormalities like prolonged QTc.&lt;SEP&gt;An electrocardiogram is a test that records the electrical activity of the heart.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-29c9b8b5fd2cd967c48522af79a9598f</data>
      <data key="d4">unknown_source</data>
