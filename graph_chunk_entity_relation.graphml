    </node>
    <node id="Beta-2 Microglobulin">
      <data key="d0">Beta-2 Microglobulin</data>
      <data key="d1">protein</data>
      <data key="d2">Beta-2 microglobulin is a protein measured in blood tests to assess disease progression.&lt;SEP&gt;Beta-2 microglobulin is a small protein found on most cells and released into the blood by B cells, with high levels suggesting CLL progression.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29&lt;SEP&gt;chunk-717174ace5855cc823d51c46c9a70648</data>
      <data key="d4">unknown_source</data>
