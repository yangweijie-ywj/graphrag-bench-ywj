      <data key="d0">Retroperitoneal Lymph Nodes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Retroperitoneal lymph nodes are located in the back of the abdomen and may be affected by ovarian cancer, as seen in stage 3A1.</data>
