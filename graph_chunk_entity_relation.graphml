    </edge>
    <edge source="Dental Exam" target="Oral Health">
      <data key="d7">1.0</data>
      <data key="d8">A dental exam evaluates oral health, which can be affected by head and neck cancer and its treatment.</data>
      <data key="d9">cancer impact,dental assessment</data>
