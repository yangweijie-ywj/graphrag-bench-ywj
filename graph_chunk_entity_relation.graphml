    </edge>
    <edge source="Dental Exam" target="Throat Cancer">
      <data key="d7">1.0</data>
      <data key="d8">A dental exam is conducted to assess oral health before starting cancer treatment.</data>
      <data key="d9">oral health,pre-treatment assessment</data>
      <data key="d10">chunk-38185832d6395b9952def9a72ecc339d</data>
