    <node id="Audiogram">
      <data key="d0">Audiogram</data>
      <data key="d1">artifact</data>
      <data key="d2">An Audiogram is a graphical representation of hearing test results, showing the range and sensitivity of hearing.&lt;SEP&gt;An audiogram is a graphical representation of the results of a pure-tone hearing test.&lt;SEP&gt;An audiogram is a graph showing the results of a pure-tone hearing test.</data>
      <data key="d3">chunk-052101b592e186cce702983d2acc67e4&lt;SEP&gt;chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0</data>
