    <node id="Probe">
      <data key="d0">Probe</data>
      <data key="d1">artifact</data>
      <data key="d2">A probe is a medical device used to visualize internal structures, such as the prostate.&lt;SEP&gt;A probe is a medical instrument used in transvaginal ultrasound to obtain images of the pelvic area.</data>
