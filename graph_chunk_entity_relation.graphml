    <node id="Skin Thickening">
      <data key="d0">Skin Thickening</data>
      <data key="d1">concept</data>
      <data key="d2">Skin thickening refers to an increase in the thickness of the breast skin, often seen in inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839861</data>
      <data key="d6" />
    </node>
    <node id="Edema">
      <data key="d0">Edema</data>
      <data key="d1">concept</data>
      <data key="d2">Edema is swelling caused by excess fluid in body tissues, which can occur in inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839862</data>
