      <data key="d6" />
    </node>
    <node id="Chapter 9">
      <data key="d0">Chapter 9</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 9 provides information on patient advocacy groups and resources for support and guidance.&lt;SEP&gt;Chapter 9 discusses osteosarcoma treatment options, which involve a combination of therapies.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585</data>
