    <node id="Pharmacogenomic Testing">
      <data key="d0">Pharmacogenomic Testing</data>
      <data key="d1">method</data>
      <data key="d2">Pharmacogenomic testing evaluates how a person's genes affect their response to medications.&lt;SEP&gt;Pharmacogenomic testing analyzes how an individual's genetic makeup affects their response to medications, helping to personalize treatment plans.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585</data>
