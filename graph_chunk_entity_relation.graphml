    <node id="Peristalsis">
      <data key="d0">Peristalsis</data>
      <data key="d1">concept</data>
      <data key="d2">Peristalsis is the wave-like muscle contractions that move food through the digestive tract.</data>
      <data key="d3">chunk-ecc6c4bcd3cab65fa05ab5f3c55e528d</data>
      <data key="d4">unknown_source</data>
