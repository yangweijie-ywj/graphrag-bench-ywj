    <node id="Older Persons">
      <data key="d0">Older Persons</data>
      <data key="d1">person</data>
      <data key="d2">Older persons are a demographic group that experiences higher rates of bone marrow involvement and more advanced-stage disease compared to mediastinal gray zone lymphomas.</data>
      <data key="d3">chunk-18b5e32980f3efa0cd012e2abab9b9fc</data>
      <data key="d4">unknown_source</data>
