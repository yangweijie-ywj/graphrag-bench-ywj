      <data key="d5">1772839811</data>
      <data key="d6" />
    </node>
    <node id="Chapter 8">
      <data key="d0">Chapter 8</data>
      <data key="d1">content</data>
      <data key="d2">Chapter 8 describes the unique treatment considerations for infant ALL, which differs from other age groups.&lt;SEP&gt;Chapter 8 addresses GCTB treatment options, as it is not typically cancer but requires aggressive treatment.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038&lt;SEP&gt;chunk-b11b0c66441242d2f687a0c55adee585</data>
