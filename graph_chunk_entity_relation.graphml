    <node id="Tissue Test">
      <data key="d0">Tissue Test</data>
      <data key="d1">data</data>
      <data key="d2">Tissue tests involve analyzing samples of body tissue to detect abnormalities, aiding in the diagnosis of cutaneous B-cell lymphoma.</data>
      <data key="d3">chunk-f9a9eb8b01f29fdf214c10bdffac3203</data>
      <data key="d4">unknown_source</data>
