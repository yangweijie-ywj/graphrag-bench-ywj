      <data key="d4">unknown_source</data>
      <data key="d5">1772839852</data>
      <data key="d6" />
    </node>
    <node id="Grade 4 Tumor">
      <data key="d0">Grade 4 Tumor</data>
      <data key="d1">concept</data>
