    <node id="Abdominal Surgery">
      <data key="d0">Abdominal Surgery</data>
      <data key="d1">procedure</data>
      <data key="d2">Abdominal surgery is a general term for procedures involving the abdomen, including transabdominal surgery.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839774</data>
      <data key="d6" />
    </node>
    <node id="Colorectal Anastomosis">
      <data key="d0">Colorectal Anastomosis</data>
      <data key="d1">procedure</data>
      <data key="d2">Colorectal anastomosis is a surgical technique to reconnect the colon to the rectum after tumor removal.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Coloanal Anastomosis">
      <data key="d0">Coloanal Anastomosis</data>
      <data key="d1">procedure</data>
      <data key="d2">Coloanal anastomosis is a surgical technique to connect the colon directly to the anus after tumor removal.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Kidney">
      <data key="d0">Kidney</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The kidney is a paired organ responsible for filtering blood and producing hormones.&lt;SEP&gt;The kidney is a vital organ responsible for filtering blood and removing waste products.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
    </node>
    <node id="Renal Cell Carcinoma">
      <data key="d0">Renal Cell Carcinoma</data>
      <data key="d1">condition</data>
      <data key="d2">Renal cell carcinoma (RCC) is the most common type of kidney cancer, originating in the cells lining the renal tubules.&lt;SEP&gt;Renal cell carcinoma is a type of kidney cancer that originates in the kidney's tubular cells.&lt;SEP&gt;Renal Cell Carcinoma (RCC) is the most common type of kidney cancer, originating in the cells lining the renal tubules.</data>
      <data key="d3">chunk-37bca9f4d2ebaeed359c9b4eb7a0c1de&lt;SEP&gt;chunk-48e138ec8da954a5667dc785e919c86b&lt;SEP&gt;chunk-a08bd0a819ea613e781d07188a350438</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839775</data>
      <data key="d6" />
