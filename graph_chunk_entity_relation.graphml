    <node id="Oxygen">
      <data key="d0">Oxygen</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Oxygen is a vital gas that is absorbed into the bloodstream through the lungs and transported to cells throughout the body.</data>
      <data key="d3">chunk-08475506372bb4ce9ec1bd326caf0fe9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839715</data>
