    <node id="Transportation">
      <data key="d0">Transportation</data>
      <data key="d1">concept</data>
      <data key="d2">Transportation refers to the costs associated with traveling to and from medical appointments related to a clinical trial.&lt;SEP&gt;Transportation refers to the means of moving between locations, which may be a cost associated with participating in clinical trials.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
      <data key="d4">unknown_source</data>
