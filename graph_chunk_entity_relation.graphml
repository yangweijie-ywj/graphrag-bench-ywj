      <data key="d1">person</data>
      <data key="d2">White Males have a lower risk of developing prostate cancer compared to Black Males.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839863</data>
