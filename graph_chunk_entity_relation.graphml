    <node id="Pheochromocytoma">
      <data key="d0">Pheochromocytoma</data>
      <data key="d1">disease</data>
      <data key="d2">Pheochromocytoma is a tumor that originates in the adrenal medulla and is characterized by symptoms like high blood pressure, headaches, and sweating.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839737</data>
