    </edge>
    <edge source="Ultrasound" target="Lymph Nodes">
      <data key="d7">1.0</data>
      <data key="d8">Ultrasound is effective at identifying small areas of cancer that may be present in lymph nodes.</data>
      <data key="d9">diagnostic tool,imaging technique</data>
