    <node id="Peau dOrange">
      <data key="d0">Peau dOrange</data>
      <data key="d1">concept</data>
      <data key="d2">Peau d’orange is a skin appearance characterized by a pitted or dimpled texture, often associated with inflammatory breast cancer.</data>
