      <data key="d1">concept</data>
      <data key="d2">Radiation therapy side effects include headaches, nausea, vomiting, and fatigue, which can be managed with medication.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839838</data>
      <data key="d6" />
    </node>
    <node id="Memory Problems">
      <data key="d0">Memory Problems</data>
      <data key="d1">concept</data>
      <data key="d2">Memory problems are long-term side effects that may occur after whole-brain radiation therapy, especially in older adults.</data>
      <data key="d3">chunk-8fbedfa2d88a7b3852f4c2bd0bb64af0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839838</data>
