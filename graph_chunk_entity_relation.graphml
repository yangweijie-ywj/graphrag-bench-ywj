    </node>
    <node id="Castration">
      <data key="d0">Castration</data>
      <data key="d1">concept</data>
      <data key="d2">Castration is a procedure that reduces testosterone levels, often used in the treatment of prostate cancer.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06</data>
