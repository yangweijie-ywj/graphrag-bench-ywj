    <node id="Mismatch Repair Deficient (dMMR)">
      <data key="d0">Mismatch Repair Deficient (dMMR)</data>
      <data key="d1">concept</data>
      <data key="d2">dMMR refers to tumors lacking proper mismatch repair function, indicating a potential biomarker for treatment.</data>
      <data key="d3">chunk-925a474b4538dda470bfd817f9d9a17d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839686</data>
