    <node id="Leukemia Cells">
      <data key="d0">Leukemia Cells</data>
      <data key="d1">concept</data>
      <data key="d2">Leukemia cells are cancerous cells that originate in the bone marrow and affect blood cell production.&lt;SEP&gt;Leukemia cells are abnormal white blood cells that multiply uncontrollably and interfere with normal blood function.</data>
      <data key="d3">chunk-06f823f3a91fcbc32c62fac3c6347715&lt;SEP&gt;chunk-0786666c65b5bf00705439d5cb60d5a0</data>
      <data key="d4">unknown_source</data>
