    </node>
    <node id="FDG">
      <data key="d0">FDG</data>
      <data key="d1">data</data>
      <data key="d2">FDG (Fluorodeoxyglucose) is a type of radiotracer used in FDG-PET/CT scans to detect cancer cell activity.&lt;SEP&gt;FDG is a radiotracer made of fluoride and glucose, used in FDG-PET/CT scans to detect cancer cells.</data>
      <data key="d3">chunk-4724f6acaaa7931560b29614efc2927f&lt;SEP&gt;chunk-30c0bb66b1a2f93e89f5342ab1077451</data>
