    <node id="CDK4/6 Inhibitor">
      <data key="d0">CDK4/6 Inhibitor</data>
      <data key="d1">artifact</data>
      <data key="d2">A CDK4/6 inhibitor is a drug that targets the CDK4/6 protein, which plays a role in cancer cell growth.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
