    <node id="Laryngoscopy">
      <data key="d0">Laryngoscopy</data>
      <data key="d1">procedure</data>
      <data key="d2">Laryngoscopy is an examination of the throat and voice box using a laryngoscope, used to detect tumors and perform biopsies.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a</data>
      <data key="d4">unknown_source</data>
