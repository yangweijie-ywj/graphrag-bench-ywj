    <node id="White Blood Cell">
      <data key="d0">White Blood Cell</data>
      <data key="d1">naturalobject</data>
      <data key="d2">White blood cells are part of the immune system and help fight infections.&lt;SEP&gt;White blood cells are a type of cell in the blood that play a role in the immune system.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68&lt;SEP&gt;chunk-d73843c009e523101e1464a2b28bc144&lt;SEP&gt;chunk-b00f93aa3d24d0275d4290db3fb2cca3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839670</data>
      <data key="d6" />
    </node>
    <node id="Platelet">
      <data key="d0">Platelet</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Platelets are small cell fragments that help in blood clotting and preventing excessive bleeding.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839670</data>
