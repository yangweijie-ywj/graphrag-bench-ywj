      <data key="d6" />
    </node>
    <node id="FDA">
      <data key="d0">FDA</data>
      <data key="d1">organization</data>
      <data key="d2">The FDA is the U.S. Food and Drug Administration, responsible for approving drugs and treatments.&lt;SEP&gt;The FDA is a U.S. government agency responsible for approving medical treatments and devices.&lt;SEP&gt;The FDA is the U.S. Food and Drug Administration responsible for approving drugs and treatments.&lt;SEP&gt;The FDA is the U.S. Food and Drug Administration responsible for approving new drugs and treatments after successful clinical trials.</data>
