    <node id="Eastern Cooperative Oncology Group">
      <data key="d0">Eastern Cooperative Oncology Group</data>
      <data key="d1">organization</data>
      <data key="d2">The Eastern Cooperative Oncology Group is an organization that develops and uses performance status scales in cancer care.&lt;SEP&gt;The Eastern Cooperative Oncology Group is an organization that provides a scale to assess a patient's performance status.&lt;SEP&gt;The Eastern Cooperative Oncology Group (ECOG) is an organization that develops performance status scales for cancer patients.</data>
      <data key="d3">chunk-33608457001e818e2b300adae9c6c0d9&lt;SEP&gt;chunk-7bdde77ad1be3ee9308db3c7703674b0&lt;SEP&gt;chunk-9fa573748870dc50a98a935843997c68</data>
