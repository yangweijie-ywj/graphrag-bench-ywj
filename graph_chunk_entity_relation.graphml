    <node id="Photodynamic Therapy">
      <data key="d0">Photodynamic Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Photodynamic therapy involves applying a light-sensitive drug to the skin and exposing it to light to kill cancer cells.&lt;SEP&gt;Photodynamic therapy is a treatment method that uses light-sensitive drugs and light to destroy cancer cells.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839696</data>
      <data key="d6" />
    </node>
    <node id="Cryotherapy">
      <data key="d0">Cryotherapy</data>
      <data key="d1">method</data>
      <data key="d2">Cryotherapy is a treatment that freezes and destroys cancer cells using a very cold liquid or tool.&lt;SEP&gt;Cryotherapy is a treatment that uses extreme cold to freeze and destroy precancerous and cancerous cells.&lt;SEP&gt;Cryotherapy is a treatment method that uses extreme cold to destroy abnormal tissue, including pre-cancerous lesions.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118&lt;SEP&gt;chunk-e8ac9bf8f198bc5ad54fd1a7b843e810</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839697</data>
      <data key="d6" />
    </node>
    <node id="Topical Therapy">
      <data key="d0">Topical Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Topical therapy involves applying medication directly to the skin to treat conditions such as actinic keratoses.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839697</data>
      <data key="d6" />
    </node>
    <node id="Curettage and Electrodesiccation">
      <data key="d0">Curettage and Electrodesiccation</data>
      <data key="d1">method</data>
      <data key="d2">Curettage and electrodesiccation is a two-step procedure involving scraping and burning to treat skin cancer.&lt;SEP&gt;Curettage and electrodesiccation is a surgical method used to remove skin cancer by scraping and burning the affected area.&lt;SEP&gt;Curettage and electrodesiccation is a surgical technique used to remove small skin cancers.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-7d994e430bb9890c905d7914fad9c118</data>
      <data key="d4">unknown_source</data>
