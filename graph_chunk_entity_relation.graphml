    <node id="Constipation">
      <data key="d0">Constipation</data>
      <data key="d1">symptom</data>
      <data key="d2">Constipation is a common side effect of systemic therapy, involving difficulty in passing stools.&lt;SEP&gt;Constipation is a common side effect of systemic therapy.&lt;SEP&gt;Constipation is a possible side effect of cancer treatment, often associated with immunotherapy.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e&lt;SEP&gt;chunk-f6fd03791661f76f6c1a246b2074b2a0</data>
