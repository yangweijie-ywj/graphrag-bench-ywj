    <node id="Insurance Cards">
      <data key="d0">Insurance Cards</data>
      <data key="d1">artifact</data>
      <data key="d2">Insurance cards are documents that provide proof of health insurance coverage.&lt;SEP&gt;Insurance cards are documents that provide information about a patient's health insurance coverage.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-705ff2bd04b2b58b98187f60f23a659e</data>
