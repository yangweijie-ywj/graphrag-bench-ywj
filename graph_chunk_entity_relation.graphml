    <node id="Tiredness">
      <data key="d0">Tiredness</data>
      <data key="d1">concept</data>
      <data key="d2">Tiredness is a common short-term side effect of radiation therapy.&lt;SEP&gt;Tiredness is a common side effect of radiation therapy.</data>
      <data key="d3">chunk-e9cc65c1c26b9e24bfb2c8c966f734a0&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
