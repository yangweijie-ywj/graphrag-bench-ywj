    </node>
    <node id="Menopause">
      <data key="d0">Menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Menopause is a natural process marked by the cessation of menstrual cycles and hormonal changes.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839683</data>
      <data key="d6" />
    </node>
    <node id="Surgical Menopause">
      <data key="d0">Surgical Menopause</data>
      <data key="d1">concept</data>
      <data key="d2">Surgical menopause is the sudden onset of menopause symptoms caused by the removal of both ovaries during surgery.&lt;SEP&gt;Surgical menopause occurs when both ovaries are removed, causing immediate menopause symptoms.</data>
      <data key="d3">chunk-e9a7fe3b15f3289198c7114b44890dea&lt;SEP&gt;chunk-cf2d987135a5936876bc819136e3a5b5</data>
      <data key="d4">unknown_source</data>
