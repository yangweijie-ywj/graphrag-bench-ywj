    <edge source="Ultrasound" target="Imaging">
      <data key="d7">1.0</data>
      <data key="d8">An ultrasound is a non-invasive imaging technique that uses sound waves to create real-time images.</data>
      <data key="d9">non-invasive imaging,real-time visualization</data>
