    </node>
    <node id="Hospitals">
      <data key="d0">Hospitals</data>
      <data key="d1">location</data>
      <data key="d2">Hospitals are medical facilities where surgeries and other treatments are performed, often with better outcomes when they have experience in specific types of cancer.</data>
      <data key="d3">chunk-e90bcd28496f1f39a21973656e3e496f</data>
      <data key="d4">unknown_source</data>
