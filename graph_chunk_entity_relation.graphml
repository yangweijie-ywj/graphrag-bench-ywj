    <node id="Rash">
      <data key="d0">Rash</data>
      <data key="d1">symptom</data>
      <data key="d2">Rash is a common side effect of targeted therapy.&lt;SEP&gt;A rash is a skin condition that can occur as a side effect of cancer treatment, such as immunotherapy.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-cd2be7a2ce722f07b19c80e6e1690a8e</data>
