    <node id="BPH">
      <data key="d0">BPH</data>
      <data key="d1">concept</data>
      <data key="d2">BPH stands for Benign Prostatic Hyperplasia, a non-cancerous enlargement of the prostate that can cause urinary symptoms.</data>
      <data key="d3">chunk-1c7418fb993bb3daa95d8563909da1de</data>
      <data key="d4">unknown_source</data>
