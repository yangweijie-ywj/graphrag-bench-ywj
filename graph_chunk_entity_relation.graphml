    <node id="Erythema">
      <data key="d0">Erythema</data>
      <data key="d1">concept</data>
      <data key="d2">Erythema is reddening of the skin, often seen in inflammatory breast cancer.</data>
      <data key="d3">chunk-6a93aa507dd7d98a02e8ba92d39e3649</data>
