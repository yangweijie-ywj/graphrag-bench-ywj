    <node id="Margin">
      <data key="d0">Margin</data>
      <data key="d1">naturalobject</data>
      <data key="d2">A margin is the area of healthy tissue surrounding a tumor that is removed during surgery to ensure complete cancer removal.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
      <data key="d4">unknown_source</data>
