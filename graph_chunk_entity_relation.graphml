      <data key="d0">Intravesical Instillation</data>
      <data key="d1">method</data>
      <data key="d2">Intravesical instillation is the process of introducing medicine into the bladder through a catheter.</data>
      <data key="d3">chunk-b0a584e54ffa22e1c25f839302bcd727</data>
      <data key="d4">unknown_source</data>
