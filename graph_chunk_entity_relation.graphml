    <node id="Neuroblastoma">
      <data key="d0">Neuroblastoma</data>
      <data key="d1">disease</data>
      <data key="d2">Neuroblastoma is a rare, cancerous adrenal tumor that primarily affects children under the age of 5.&lt;SEP&gt;Neuroblastoma is a rare, cancerous adrenal tumor that primarily affects children under the age of 5 and can spread to other parts of the body.</data>
      <data key="d3">chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
