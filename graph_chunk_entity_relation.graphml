    <node id="Early-Stage Cancer">
      <data key="d0">Early-Stage Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Early-stage esophageal cancer is contained within the esophagus and has not spread to lymph nodes.&lt;SEP&gt;Early-stage cancer refers to cancer that has not spread beyond the original site.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-cb36cedd3f66584d65304e58b668eeab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839810</data>
      <data key="d6" />
    </node>
    <node id="Locally Advanced Cancer">
      <data key="d0">Locally Advanced Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Locally Advanced Cancer is a stage of cervical cancer that has spread beyond the cervix but not to distant parts of the body.&lt;SEP&gt;Locally advanced cancer refers to cancer that has spread to nearby tissues or lymph nodes.</data>
      <data key="d3">chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-95c76786e9d6dbf06ddf5d55af0cf658</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839810</data>
      <data key="d6" />
    </node>
    <node id="Infraclavicular Nodes">
      <data key="d0">Infraclavicular Nodes</data>
      <data key="d1">location</data>
      <data key="d2">Infraclavicular nodes are lymph nodes located beneath the clavicle.&lt;SEP&gt;Infraclavicular nodes are located below the collarbone and may be involved in breast cancer spread.</data>
      <data key="d3">chunk-cb41559e96b71d2bb4ea207c806e8d5f&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872</data>
