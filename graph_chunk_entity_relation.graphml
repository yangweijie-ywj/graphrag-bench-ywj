    <node id="Asian Males">
      <data key="d0">Asian Males</data>
      <data key="d1">person</data>
      <data key="d2">Asian Males are less likely to be diagnosed with prostate cancer compared to both White and Black Males.</data>
      <data key="d3">chunk-aa251c48fc1fccfe45605a384f743662</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839863</data>
      <data key="d6" />
