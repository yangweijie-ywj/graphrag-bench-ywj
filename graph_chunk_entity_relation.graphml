      <data key="d5">1772839673</data>
      <data key="d6" />
    </node>
    <node id="B-ALL Risk Groups">
      <data key="d0">B-ALL Risk Groups</data>
      <data key="d1">concept</data>
      <data key="d2">B-ALL risk groups classify the severity and prognosis of B-cell acute lymphoblastic leukemia.</data>
      <data key="d3">chunk-c5bc83f5f4f3e29b7f0a6f4787c3ad83</data>
