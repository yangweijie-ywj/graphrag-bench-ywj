    </node>
    <node id="Monitoring">
      <data key="d0">Monitoring</data>
      <data key="d1">method</data>
      <data key="d2">Monitoring is the process of regularly checking a patient's condition to detect any changes or signs of cancer recurrence.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-121b68d5de585c87804c9bce3cdc71eb&lt;SEP&gt;chunk-8b44f0b4da13a804cd1dfb917ac7e981</data>
      <data key="d4">unknown_source</data>
