    </node>
    <node id="ERBB">
      <data key="d0">ERBB</data>
      <data key="d1">artifact</data>
      <data key="d2">ERBB is a group of genes involved in cell signaling and is associated with several types of cancer.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839742</data>
      <data key="d6" />
    </node>
    <node id="Grading">
      <data key="d0">Grading</data>
      <data key="d1">concept</data>
      <data key="d2">Grading is a classification system used to determine how fast a tumor is likely to grow, based on its cellular characteristics.&lt;SEP&gt;Grading is the process of evaluating how quickly cancer cells are growing and dividing.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-da0bfe00946dcdff3a8a6fb3d73ce6e1</data>
