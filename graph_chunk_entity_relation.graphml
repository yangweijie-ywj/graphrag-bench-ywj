    <node id="Second Opinion">
      <data key="d0">Second Opinion</data>
      <data key="d1">concept</data>
      <data key="d2">A second opinion is an additional medical evaluation provided by another physician to confirm or clarify a diagnosis.&lt;SEP&gt;A review of a cancer diagnosis and treatment plan by another doctor.&lt;SEP&gt;A second opinion is an additional evaluation by another doctor to confirm or provide alternative insights into a diagnosis or treatment plan.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe&lt;SEP&gt;chunk-419f40f64b13b1b2d0fac3cfb9fde92a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839731</data>
      <data key="d6" />
    </node>
    <node id="FDG-PET">
      <data key="d0">FDG-PET</data>
      <data key="d1">equipment</data>
      <data key="d2">FDG-PET is a type of PET scan that uses a radioactive sugar tracer to detect cancer cells.&lt;SEP&gt;FDG-PET is a type of PET scan that uses a radioactive sugar called 18-fluorodeoxyglucose as a tracer.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839731</data>
      <data key="d6" />
    </node>
    <node id="SSTRPET">
      <data key="d0">SSTRPET</data>
      <data key="d1">equipment</data>
      <data key="d2">SSTRPET is a specialized type of PET scan used for adrenal tumors, utilizing a different tracer than FDG-PET.&lt;SEP&gt;SSTRPET is a type of PET scan that uses a tracer binding to somatostatin receptors on cancer cells.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839731</data>
      <data key="d6" />
    </node>
    <node id="Adrenal Tumors">
      <data key="d0">Adrenal Tumors</data>
      <data key="d1">concept</data>
      <data key="d2">Adrenal tumors are growths that form in one or both adrenal glands and can be benign or malignant.&lt;SEP&gt;Adrenal tumors are growths that can develop in one or both adrenal glands and can be benign or malignant.&lt;SEP&gt;Adrenal tumors are abnormal growths in the adrenal glands, which may be benign or malignant.&lt;SEP&gt;Adrenal tumors are growths on the adrenal glands that can be detected using specific imaging techniques.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-7102a43dfb62e649d725bc95ba292688&lt;SEP&gt;chunk-f1379433bc205cdec8af2edc77613acb&lt;SEP&gt;chunk-f8eae4d6dadf6a6fbd339efa4dec2172</data>
