      <data key="d0">Stomach Adenocarcinomas</data>
      <data key="d1">concept</data>
      <data key="d2">Stomach adenocarcinomas are cancers that originate in the lining of the stomach and produce mucus.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
