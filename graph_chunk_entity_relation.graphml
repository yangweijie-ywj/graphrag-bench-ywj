    <node id="Adolescent and Young Adult Cancer">
      <data key="d0">Adolescent and Young Adult Cancer</data>
      <data key="d1">concept</data>
      <data key="d2">Adolescent and young adult cancer refers to cancer affecting individuals in this age group.</data>
      <data key="d3">chunk-ba28a3ce3534c0655a0d08a953d7f038</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839812</data>
