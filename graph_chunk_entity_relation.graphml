      <data key="d0">Confusion</data>
      <data key="d1">symptom</data>
      <data key="d2">Confusion is a problem with thinking that can occur due to a brain tumor.</data>
      <data key="d3">chunk-49c7ff3a71e74b3f0eb59258541e739e</data>
