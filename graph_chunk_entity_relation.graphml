    <node id="Stage 1B">
      <data key="d0">Stage 1B</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 1B is a stage of ovarian cancer where cancer is present in both ovaries with intact capsules and no cancer on the outer surfaces or in ascites.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Stage 1C">
      <data key="d0">Stage 1C</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 1C is a stage of ovarian cancer where cancer is present in one or both ovaries, with additional factors such as surgical spill, capsule rupture, or cancer cells in ascites.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Stage 2A">
      <data key="d0">Stage 2A</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 2A is a stage of ovarian cancer where cancer has spread to the uterus and/or fallopian tubes.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A1">
      <data key="d0">Stage 3A1</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3A1 is a stage of ovarian cancer where cancer has spread to retroperitoneal lymph nodes, with specific subcategories based on the size of the lymph node involvement.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Stage 3A2">
      <data key="d0">Stage 3A2</data>
      <data key="d1">concept</data>
      <data key="d2">Stage 3A2 is a stage of ovarian cancer where cancer has spread to the tissue lining the abdomen, visible only under a microscope, with possible lymph node involvement.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
      <data key="d6" />
    </node>
    <node id="Taxane">
      <data key="d0">Taxane</data>
      <data key="d1">method</data>
      <data key="d2">Taxane is a class of chemotherapy drugs used in combination with platinum-based therapies to treat ovarian cancer.</data>
      <data key="d3">chunk-b69d38fafe014cece3427bd0459ae42b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839851</data>
