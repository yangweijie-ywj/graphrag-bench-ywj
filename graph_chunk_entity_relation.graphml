    </node>
    <node id="IGHV">
      <data key="d0">IGHV</data>
      <data key="d1">gene</data>
      <data key="d2">IGHV is a gene involved in the development of B cells and may have mutations in CLL.</data>
      <data key="d3">chunk-67015f3916810c4378b2ed269cc27f29</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839818</data>
