    <node id="Fecal Incontinence">
      <data key="d0">Fecal Incontinence</data>
      <data key="d1">concept</data>
      <data key="d2">Fecal incontinence is the inability to control bowel movements, leading to accidental leakage of stool.&lt;SEP&gt;Fecal incontinence is the inability to control bowel movements, often experienced after anal cancer treatment.</data>
      <data key="d3">chunk-cf41d1c08e8df109ad214d831867a5d9&lt;SEP&gt;chunk-6236b93e627d54f73f1c8fe341127e67</data>
