      <data key="d6" />
    </node>
    <node id="Tumor Formed in Damaged Skin">
      <data key="d0">Tumor Formed in Damaged Skin</data>
      <data key="d1">attribute</data>
      <data key="d2">Tumor formed in damaged skin refers to cancer arising in areas previously treated with radiation or affected by wounds or scars.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839698</data>
      <data key="d6" />
    </node>
    <node id="Nerve Damage">
      <data key="d0">Nerve Damage</data>
      <data key="d1">concept</data>
      <data key="d2">Nerve damage refers to cancer that invades nerves, increasing the risk of recurrence and spread.&lt;SEP&gt;Nerve damage, also known as neuropathy, is a potential side effect of cisplatin treatment.&lt;SEP&gt;Nerve damage can be a long-term side effect of extended treatment with oxaliplatin, affecting fingers and toes.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-8ec4d44b145ca896ff1216caa90ce5dd&lt;SEP&gt;chunk-c35816f05289661283f683145d9f395f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839698</data>
      <data key="d6" />
    </node>
    <node id="Tumor Grade">
      <data key="d0">Tumor Grade</data>
      <data key="d1">concept</data>
      <data key="d2">Tumor grade refers to how quickly cancer cells grow and spread, based on their appearance under a microscope.&lt;SEP&gt;Tumor grade is a classification system used to determine how quickly cancer cells grow and spread based on their appearance under a microscope.&lt;SEP&gt;Tumor grade describes how abnormal cancer cells look under a microscope and can influence prognosis and treatment.&lt;SEP&gt;Tumor grade describes how abnormal cancer cells look under a microscope, indicating their likelihood of spreading.&lt;SEP&gt;Tumor grade describes how abnormal cancer cells look under a microscope, ranging from GX to G3.&lt;SEP&gt;Tumor grade describes how abnormal cancer cells look under a microscope.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-6b02315423350f3598288e189fbcb8ae&lt;SEP&gt;chunk-0d388da75afb5ea2d01c97e55cb2b872&lt;SEP&gt;chunk-f8639a06098656be20a04fe129660616</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839698</data>
      <data key="d6" />
    </node>
    <node id="Tumor Type">
      <data key="d0">Tumor Type</data>
      <data key="d1">attribute</data>
      <data key="d2">Tumor type refers to the specific form of cancer diagnosed, based on tissue samples and microscopic analysis.&lt;SEP&gt;The tumor type refers to the classification of a tumor based on its cellular structure, genetic markers, and other characteristics.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-ffc3446f8ec092af24a460bda94f772f</data>
      <data key="d4">unknown_source</data>
