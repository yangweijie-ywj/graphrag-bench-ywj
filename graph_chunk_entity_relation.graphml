      <data key="d4">unknown_source</data>
      <data key="d5">1772839726</data>
      <data key="d6" />
    </node>
    <node id="Transformation Zone">
      <data key="d0">Transformation Zone</data>
      <data key="d1">location</data>
      <data key="d2">The transformation zone is the area where the ectocervix meets the endocervix and is a common site for cervical cancer development.&lt;SEP&gt;The transformation zone is the area where the ectocervix and endocervix meet, and most cervical cancers originate.&lt;SEP&gt;The transformation zone is the area of the cervix where pre-cancerous changes commonly occur.</data>
      <data key="d3">chunk-27b3a0f53b4be1d525497f87555d7a06&lt;SEP&gt;chunk-d249262ff9e7e657de99a30199159cdf&lt;SEP&gt;chunk-b4d036ee5fd77783b9e7ddef3a8477ae</data>
