    <node id="PSA Density">
      <data key="d0">PSA Density</data>
      <data key="d1">concept</data>
      <data key="d2">PSA density is a calculation that adjusts PSA levels based on the size of the prostate, helping to determine cancer risk more accurately.&lt;SEP&gt;PSA density is a measure used to evaluate the concentration of PSA in the blood relative to the size of the prostate.</data>
      <data key="d3">chunk-b3958b5f7df8a8fc2661705e37dc1e06&lt;SEP&gt;chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
