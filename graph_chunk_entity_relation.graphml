    <node id="PIK3CA">
      <data key="d0">PIK3CA</data>
      <data key="d1">artifact</data>
      <data key="d2">PIK3CA is a gene frequently mutated in breast cancers, leading to increased cancer cell growth and treatment resistance.&lt;SEP&gt;PIK3CA is a gene involved in cell growth and is associated with various cancers.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-e45947107c74d8a06e350be57a94a408</data>
