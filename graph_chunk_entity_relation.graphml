    <node id="Sexual Dysfunction">
      <data key="d0">Sexual Dysfunction</data>
      <data key="d1">symptom</data>
      <data key="d2">Sexual dysfunction is a potential side effect of bladder cancer treatment, affecting a patient's ability to engage in sexual activity.&lt;SEP&gt;A condition affecting sexual health and function, often a result of cancer treatment.</data>
      <data key="d3">chunk-541f1323a24c5990b4a6408e0c5442ab&lt;SEP&gt;chunk-44a870810cef881997b741c32ec368fe</data>
