    <node id="Primary Cutaneous Lymphomas">
      <data key="d0">Primary Cutaneous Lymphomas</data>
      <data key="d1">concept</data>
      <data key="d2">Primary cutaneous lymphomas (PCL) are a rare group of NHLs that develop from abnormal B or T lymphocytes in the skin.</data>
      <data key="d3">chunk-196a80cd0ae47fda3849b101cca91a15</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839651</data>
