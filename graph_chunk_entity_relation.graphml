    </node>
    <node id="Tumor Stage">
      <data key="d0">Tumor Stage</data>
      <data key="d1">concept</data>
      <data key="d2">Tumor stage is a factor used in determining a patient's risk group, indicating the extent of cancer spread within the body.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839741</data>
      <data key="d6" />
    </node>
    <node id="Gleason Patterns">
      <data key="d0">Gleason Patterns</data>
      <data key="d1">concept</data>
      <data key="d2">Gleason patterns are classifications of cancer cell appearances under a microscope, used to determine the Gleason score.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839741</data>
      <data key="d6" />
    </node>
    <node id="Grade Group 2">
      <data key="d0">Grade Group 2</data>
      <data key="d1">concept</data>
      <data key="d2">Grade Group 2 is a classification of prostate cancer aggressiveness, corresponding to a Gleason score of 7.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839741</data>
      <data key="d6" />
    </node>
    <node id="Grade Group 3">
      <data key="d0">Grade Group 3</data>
      <data key="d1">concept</data>
      <data key="d2">Grade Group 3 is a classification of prostate cancer aggressiveness, corresponding to a Gleason score of 7, with more aggressive characteristics than Grade Group 2.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839742</data>
      <data key="d6" />
    </node>
    <node id="Urogram">
      <data key="d0">Urogram</data>
      <data key="d1">method</data>
      <data key="d2">Urogram is a medical imaging test that uses contrast to visualize the urinary tract.&lt;SEP&gt;A urogram is a type of imaging that uses a contrast solution with CT or MRI to evaluate the function of the urinary tract.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a&lt;SEP&gt;chunk-76a038845aaedb9ef7852018f26778b3</data>
