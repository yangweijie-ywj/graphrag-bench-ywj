    <node id="Immunosuppression">
      <data key="d0">Immunosuppression</data>
      <data key="d1">concept</data>
      <data key="d2">Immunosuppression is a condition where the immune system is weakened, increasing the risk of developing primary CNS lymphoma.</data>
      <data key="d3">chunk-4966a628b12ecec4187796598764cf23</data>
