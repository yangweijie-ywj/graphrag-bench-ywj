    <node id="Mind and Body Therapies">
      <data key="d0">Mind and Body Therapies</data>
      <data key="d1">method</data>
      <data key="d2">Mind and body therapies are holistic approaches that aim to improve mental and physical well-being during cancer treatment.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839813</data>
