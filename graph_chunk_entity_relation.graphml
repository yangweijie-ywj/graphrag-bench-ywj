    <node id="Ovarian Suppression">
      <data key="d0">Ovarian Suppression</data>
      <data key="d1">method</data>
      <data key="d2">Ovarian suppression is a treatment that reduces hormone production in premenopausal women.&lt;SEP&gt;Ovarian suppression is a treatment that uses drugs to temporarily stop the ovaries from making hormones.</data>
      <data key="d3">chunk-e45947107c74d8a06e350be57a94a408&lt;SEP&gt;chunk-9040f5949ae0ff36ce88faa1f4b67ead</data>
