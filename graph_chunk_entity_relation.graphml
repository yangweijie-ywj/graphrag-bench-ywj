      <data key="d0">Fertility-Sparing Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Fertility-sparing surgery is an option for early-stage ovarian cancer to preserve reproductive function.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839848</data>
