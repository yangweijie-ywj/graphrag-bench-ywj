    <node id="Stomach Wall">
      <data key="d0">Stomach Wall</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The stomach wall is composed of multiple layers including the mucosa, submucosa, muscle layer, subserosa, and serosa.</data>
      <data key="d3">chunk-01c80b2d18abb91c5be598d33cf7a33a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839737</data>
