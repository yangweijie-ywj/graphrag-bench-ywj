      <data key="d0">Bilateral Salpingooophorectomy</data>
      <data key="d1">artifact</data>
      <data key="d2">Bilateral salpingooophorectomy is a surgery to remove both ovaries and fallopian tubes, commonly performed in ovarian cancer treatment.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb</data>
      <data key="d4">unknown_source</data>
