    <node id="Risk Group">
      <data key="d0">Risk Group</data>
      <data key="d1">concept</data>
      <data key="d2">A risk group is a classification used in medical prognosis to determine the likelihood of disease progression and guide treatment decisions.</data>
      <data key="d3">chunk-1d61a5e7031ea811cc4dcc55a0a0e8fa</data>
      <data key="d4">unknown_source</data>
