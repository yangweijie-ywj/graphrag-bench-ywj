    <node id="Pelvic Exenteration">
      <data key="d0">Pelvic Exenteration</data>
      <data key="d1">procedure</data>
      <data key="d2">Pelvic exenteration is a surgical procedure involving the removal of pelvic organs.&lt;SEP&gt;Pelvic exenteration is a radical surgical procedure that involves removing multiple pelvic organs to treat cancer.</data>
      <data key="d3">chunk-9d0e32bdc49dbab9c2c953abf363e317&lt;SEP&gt;chunk-b3ba7430f3a31330247f52afe7e9c68a</data>
