    <node id="Precision-Directed Excision and Margin Assessment">
      <data key="d0">Precision-Directed Excision and Margin Assessment</data>
      <data key="d1">method</data>
      <data key="d2">Precision-Directed Excision and Margin Assessment (PDEMA) is a surgical technique used to remove cancerous tissue with precision.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
