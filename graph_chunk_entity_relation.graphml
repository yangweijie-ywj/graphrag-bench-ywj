    <node id="Extractions">
      <data key="d0">Extractions</data>
      <data key="d1">procedure</data>
      <data key="d2">Extractions are the removal of teeth, often planned using panoramic dental x-rays.</data>
      <data key="d3">chunk-50531346164ea7c08dd087a868b3cc2a&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23</data>
