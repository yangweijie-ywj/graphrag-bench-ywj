    <node id="Childcare">
      <data key="d0">Childcare</data>
      <data key="d1">concept</data>
      <data key="d2">Childcare refers to the costs associated with caring for children due to additional appointments required during a clinical trial.&lt;SEP&gt;Childcare refers to services that care for children, which may be an indirect cost related to participation in clinical trials.</data>
      <data key="d3">chunk-e74c94f9f2ff33172671e8742338c6d1&lt;SEP&gt;chunk-541f1323a24c5990b4a6408e0c5442ab</data>
