      <data key="d0">NTRK Gene Fusions</data>
      <data key="d1">data</data>
      <data key="d2">NTRK gene fusions are genetic alterations that can influence treatment options in some cancers.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839893</data>
      <data key="d6" />
    </node>
    <node id="Mirvetuximab Soravtansine-Gynx">
      <data key="d0">Mirvetuximab Soravtansine-Gynx</data>
      <data key="d1">drug</data>
      <data key="d2">Mirvetuximab soravtansine-gynx (Elahere) is a targeted therapy drug used in the treatment of recurrent ovarian cancer with folate receptor alpha (FRα) expression.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839893</data>
      <data key="d6" />
    </node>
    <node id="Platinum-Resistant Cancer">
      <data key="d0">Platinum-Resistant Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Platinum-resistant cancer refers to ovarian cancer that does not respond to platinum-based chemotherapy or recurs within 6 months of treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839894</data>
      <data key="d6" />
    </node>
    <node id="Platinum-Sensitive Cancer">
      <data key="d0">Platinum-Sensitive Cancer</data>
      <data key="d1">condition</data>
      <data key="d2">Platinum-sensitive cancer refers to ovarian cancer that responds well to platinum-based chemotherapy and recurs more than 6 months after treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839894</data>
      <data key="d6" />
    </node>
    <node id="Secondary Cytoreductive Surgery">
      <data key="d0">Secondary Cytoreductive Surgery</data>
      <data key="d1">method</data>
      <data key="d2">Secondary cytoreductive surgery is a procedure to remove visible cancer after recurrence, often performed before starting recurrence treatment.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839894</data>
      <data key="d6" />
    </node>
    <node id="Hypersensitivity Reaction">
      <data key="d0">Hypersensitivity Reaction</data>
      <data key="d1">concept</data>
      <data key="d2">A hypersensitivity reaction is an allergic response that can occur with repeated use of certain chemotherapy drugs like carboplatin and cisplatin.</data>
      <data key="d3">chunk-c622c677deca24391324ecd5f16ce4a3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839894</data>
      <data key="d6" />
