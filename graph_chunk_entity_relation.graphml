    <node id="Transducer">
      <data key="d0">Transducer</data>
      <data key="d1">artifact</data>
      <data key="d2">A transducer is a device used in ultrasound to emit and receive sound waves for imaging.&lt;SEP&gt;Transducer is a device used in ultrasound to emit and receive sound waves.</data>
