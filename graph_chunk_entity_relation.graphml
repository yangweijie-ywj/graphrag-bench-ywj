    <node id="High-Grade Serous Carcinoma">
      <data key="d0">High-Grade Serous Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">High-grade serous carcinoma is a common type of ovarian cancer characterized by aggressive growth and spread.&lt;SEP&gt;High-grade serous carcinoma is the most common type of ovarian cancer, characterized by aggressive growth.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839847</data>
      <data key="d6" />
    </node>
    <node id="High-Grade Endometrioid Carcinoma">
      <data key="d0">High-Grade Endometrioid Carcinoma</data>
      <data key="d1">concept</data>
      <data key="d2">High-grade endometrioid carcinoma is another common type of ovarian cancer with distinct cellular features.&lt;SEP&gt;High-grade endometrioid carcinoma is another common type of ovarian cancer, often associated with endometriosis.</data>
      <data key="d3">chunk-77ac570b4029abb181150e0d0975aefb&lt;SEP&gt;chunk-b4da30dee72e228147daa825e4f5be72</data>
      <data key="d4">unknown_source</data>
