    <node id="Preventing Pregnancy During Treatment">
      <data key="d0">Preventing Pregnancy During Treatment</data>
      <data key="d1">method</data>
      <data key="d2">Preventing pregnancy during treatment involves measures to avoid conception while undergoing cancer therapy.</data>
      <data key="d3">chunk-38185832d6395b9952def9a72ecc339d&lt;SEP&gt;chunk-3fbf2f6a3c150687a59f814d94f1d150</data>
