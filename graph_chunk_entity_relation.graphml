    </node>
    <node id="Cystoscope">
      <data key="d0">Cystoscope</data>
      <data key="d1">equipment</data>
      <data key="d2">A cystoscope is a medical instrument with a camera and light used to view the inside of the bladder.&lt;SEP&gt;A cystoscope is a medical instrument used to view the inside of the bladder and perform biopsies or remove small tumors.</data>
      <data key="d3">chunk-76a038845aaedb9ef7852018f26778b3&lt;SEP&gt;chunk-dea00cf063e8831db4919330d94b1f2a</data>
