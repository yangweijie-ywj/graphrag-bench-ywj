    <node id="Microscope">
      <data key="d0">Microscope</data>
      <data key="d1">artifact</data>
      <data key="d2">A microscope is a scientific instrument used to view small objects, such as cancer cells, in detail.&lt;SEP&gt;A microscope is an instrument used to view cells and tissues at a microscopic level.</data>
