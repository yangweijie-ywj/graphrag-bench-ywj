    <node id="Sessile Polyps">
      <data key="d0">Sessile Polyps</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Sessile polyps are flat growths without a stalk that attach directly to the rectal wall.&lt;SEP&gt;Sessile polyps are flat, non-attached growths on the colon wall that can be more difficult to detect.</data>
      <data key="d3">chunk-ee254e84e63bd35682ed56c41cef9247&lt;SEP&gt;chunk-f2c9770fd98dbbe3c7947601fb3e654c</data>
