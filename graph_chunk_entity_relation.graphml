    <node id="Medicines">
      <data key="d0">Medicines</data>
      <data key="d1">artifact</data>
      <data key="d2">Medicines are substances used to treat or prevent diseases, often prescribed by healthcare professionals.&lt;SEP&gt;Medicines are pharmaceutical products used to treat or manage various health conditions, including nicotine addiction.</data>
      <data key="d3">chunk-a9d0006f1c78fe4fa7bb74b756033104&lt;SEP&gt;chunk-9ad38c9dc069a8ff8df58c42f00eba23</data>
