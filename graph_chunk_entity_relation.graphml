    <node id="Low-Risk">
      <data key="d0">Low-Risk</data>
      <data key="d1">category</data>
      <data key="d2">Low-risk refers to cancers with a lower likelihood of recurrence or metastasis.&lt;SEP&gt;Low-risk refers to a classification of cancer that is less likely to spread or recur after treatment.</data>
      <data key="d3">chunk-60426652ddf8265bf75caba550026d38&lt;SEP&gt;chunk-a9d0006f1c78fe4fa7bb74b756033104</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839697</data>
      <data key="d6" />
