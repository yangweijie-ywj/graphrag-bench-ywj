    <node id="Chest Imaging">
      <data key="d0">Chest Imaging</data>
      <data key="d1">method</data>
      <data key="d2">Chest imaging is a diagnostic technique using CT scans or X-rays to examine the lungs and surrounding areas.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839742</data>
      <data key="d6" />
    </node>
    <node id="Inherited Cancer Risk">
      <data key="d0">Inherited Cancer Risk</data>
      <data key="d1">concept</data>
      <data key="d2">Inherited cancer risk refers to the increased likelihood of developing cancer due to genetic mutations passed from parents.</data>
      <data key="d3">chunk-7a890e27eba8c63d10f19b85a72fc14a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1772839742</data>
