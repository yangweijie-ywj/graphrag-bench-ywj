    <node id="Zipped Pocket">
      <data key="d0">Zipped Pocket</data>
      <data key="d1">artifact</data>
      <data key="d2">A zipped pocket is a compartment in a medical binder used to store small items like pens and insurance cards.&lt;SEP&gt;A zipped pocket is a feature on a medical binder used to store small items like pens, calendars, and insurance cards.</data>
      <data key="d3">chunk-aa14ecd19e2d721cb99ea9590f0ede3a&lt;SEP&gt;chunk-6eafb110f88c7af38808f77f59ed155d</data>
      <data key="d4">unknown_source</data>
